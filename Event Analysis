/*事件分析(CV_ADHF)*/
data last;
set last;
if CV_death = 1| ADHF = 1 then CV_ADHF = 1;
else if missing(CV_death) & missing(ADHF) then CV_ADHF = .;
else CV_ADHF=0;
if CV_death = 1| ADHF = 1| nonfetal_MI = 1| nonfetal_stroke = 1 then cardio_events=1;
else if missing(CV_death) & missing(ADHF) & missing(nonfetal_MI) & missing(nonfetal_stroke) then cardio_events = .;
else cardio_events=0;
ADHF_DT_scan=scan(End_Point_ADHF_DT1,1,' ');
nonfetal_MI_DT_scan=scan(End_Point_nonfetal_MI_DT1,1,' ');
array old End_Point_CV_death_DT ADHF_DT_scan nonfetal_MI_DT_scan;
array new CV_death_DT_int ADHF_DT_scan_int nonfetal_MI_DT_scan_int;
	do i= 1 to 3;
	new{i}=mdy(scan(old{i}, 1, '/'), scan(old{i}, 2, '/'), scan(old{i}, 3, '/'));
	end;
nonfetal_stroke_DT_int=datepart(End_Point_nonfetal_stroke_DT1);
CV_ADHF_DT_int=min(ADHF_DT_scan_int, CV_death_DT_int);
cardio_events_DT_int=min(CV_death_DT_int, ADHF_DT_scan_int, nonfetal_MI_DT_scan_int, nonfetal_stroke_DT_int);
if API_Visit= 888 then API_Visit= .;
Discharge_date_DT_int=mdy(scan(Discharge_date, 1, '/'), scan(Discharge_date, 2, '/'), scan(Discharge_date, 3, '/'));
array var CV_death_DT_int ADHF_DT_scan_int CV_ADHF_DT_int cardio_events_DT_int;
array time time_CV_death time_ADHF time_CV_ADHF time_cardio_events;
	do j= 1 to 4;
	if var{j}=. then var{j}=mdy('5', '29', '2023');
	time{j}= var{j}-Discharge_date_DT_int;
	if time{j}<0 then delete;
	end;
drop i j;
run;
