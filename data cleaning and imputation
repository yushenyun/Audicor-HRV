%macro changename(data=, new_data=, height=, normal=, original=, Subject_ID=, final=);
data &data;
set &data;
if _LABEL_='' then _LABEL_=_NAME_;
run;

proc transpose data=&data out=&new_data(rename=(&height=Height_Weight_BMI &normal=API_SDNN_normal));
ID _LABEL_;
run;

data &new_data;
merge Subject_ID &new_data;
drop _NAME_;
run;

data &Subject_ID;
set &original;
keep Subject_ID;
run;

proc sql;
create table &final as
select a.*, b.*
from &Subject_ID a
inner join &new_data b
on a.Subject_ID = b.Subject_ID;
quit;

