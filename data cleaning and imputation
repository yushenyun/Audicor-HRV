/*橫向合併*//*更改名字後合併*/
%macro file_rename(old_data, new_data, var);
data &new_data ;
  set &old_data;
  %macro rename(oldvarlist, suffix);
  %let k=1;
  %let old = %scan(&oldvarlist, &k);
     %do %while("&old" NE "");
      rename &old = &old.&suffix;
	  %let k = %eval(&k + 1);
      %let old = %scan(&oldvarlist, &k);
  %end;
  %mend;
  %rename(&vars, &var);
run;

proc sort data=&new_data;
by Subject_ID;
run;
%mend file_rename;
