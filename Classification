/*改為類別*/
%macro classification(data);
data &data;
set &data;
if Echo_LVEF < 50 then EF=1;
else if Echo_LVEF >= 50 then EF=0;
if API_QRS_DUR >= 120 then QRS=1;
else if API_QRS_DUR < 120 then QRS=0;
if API_QoS1 >= 120 then EMAT=1;
else if API_QoS1 < 120 then EMAT=0;
if API_PercentQoS1 >= 15 then EMATP=1;
else if API_PercentQoS1 < 15 then EMATP=0;
if API_S3DisplayValue >= 5 then S3=1;
else if API_S3DisplayValue < 5 then S3=0;
if API_S4DisplayValue >= 5 then S4=1;
else if API_S4DisplayValue < 5 then S4=0;
if API_SDI >= 5 then SDI=1;
else if API_SDI < 5 then SDI=0;
if API_SDNN_normal < 30 then SDNN=1;
else if API_SDNN_normal >= 30 then SDNN=0;
run;
%mend classification;
%classification(data=screening_final);
%classification(data=v0_final);
%classification(data=v1_final);
